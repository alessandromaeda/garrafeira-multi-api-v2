	</http:request-config>

	<sub-flow name="garrafeira-testes-login-and-generate-digest" doc:id="b47fe80a-48a5-4911-82a5-97a373785896">
		<ee:transform doc:name="Set Variable user e pass" doc:id="608ba04b-a7d6-4ed5-a94c-9f8eff6fff8" >
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="user"><![CDATA["MuleSoftTEST"]]></ee:set-variable>
				<ee:set-variable variableName="pass"><![CDATA["URymxz4&quuoHDU6"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="GET" doc:name="to request login" doc:id="703e73b7-62fc-4af1-9461-af479366df79" config-ref="HTTP_Request_configuration" path="/login" target="challenge" targetValue="#[attributes.headers.digest]">
			<http:headers><![CDATA[#[output application/java
---
{
	name : vars.user
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Logger" doc:id="4c21844c-88e5-4d23-9bfd-b5fb8dd950c5" message="Iniciando digest..." />
		<java:invoke-static method="computeDigest(java.lang.String,java.lang.String,java.lang.String)" doc:name="Invoke static" doc:id="5ef2e52c-2f44-4d74-b525-81ceecc78cde" class="utility.ArtSoft" target="digest">
			<java:args><![CDATA[
            #[{
                arg0: vars.user,
                arg1: vars.pass,
                arg2: vars.challenge
            }]
        ]]></java:args>
		</java:invoke-static>
	</sub-flow>

