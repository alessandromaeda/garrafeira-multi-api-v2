	<sub-flow name="informacoes-tabelas-fetch-page-subflow" doc:id="d938b812-70b9-4a41-b841-39659b83b123">
		<flow-ref doc:name="Refresh Login and Digest" name="garrafeira-testes-login-and-generate-digest" />
		<ee:transform doc:name="Prepare Query XML with start" doc:id="a5381f21-7299-4c2f-b482-123456789abc">
			<ee:variables>
				<ee:set-variable variableName="currentQueryXml"><![CDATA[%dw 2.0
output text/plain
var rawQuery = vars.baseQuery default vars.StkFch_All_Fields
var queryStr = if (rawQuery is String) rawQuery else write(rawQuery, "application/xml", {writeDeclaration: false})
var queryMatches = queryStr scan /query="([^"]*)"/
var queryAttribute = queryMatches[0][0] default null
var queryValue = queryMatches[0][1] default null
var paginatedQueryValue =
	if (isEmpty(queryValue) or isEmpty(vars.nextRecord))
		queryValue
	else if (queryValue contains "|#")
		queryValue replace /\|#[^\s]*/ with ("|#" ++ (vars.nextRecord as String))
	else
		queryValue ++ " |#" ++ (vars.nextRecord as String)
---
if (!isEmpty(vars.nextRecord) and !isEmpty(queryAttribute))
	queryStr replace queryAttribute with ('query="' ++ paginatedQueryValue ++ '"')
else
	queryStr]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="POST" doc:name="/Queries/Query" doc:id="42597292-a988-4115-a606-3aafb60c5638" config-ref="HTTP_Request_configuration" path="/Queries/Query" outputMimeType="application/octet-stream" requestStreamingMode="NEVER">
			<repeatable-in-memory-stream />
			<http:body><![CDATA[#[vars.currentQueryXml]]]></http:body>
			<http:headers><![CDATA[#[{
	digest: vars.digest,
	'Content-Type': 'application/xml'
}]]]></http:headers>
		</http:request>
		<ee:transform doc:name="Transform Message" doc:id="4a7d34bb-f99b-4361-a315-f125bd39ee6e">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/xml
---
read(payload as String {encoding: "windows-1252"}, "application/xml")]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<ee:transform doc:name="Accumulate &amp; Extract Next" doc:id="829f2719-7489-4911-a831-29182a981273">
			<ee:variables>
				<ee:set-variable variableName="accumulatedResults"><![CDATA[%dw 2.0
output application/java
---
(vars.accumulatedResults default []) + [payload]]]></ee:set-variable>
				<ee:set-variable variableName="usedCursors"><![CDATA[%dw 2.0
output application/java
---
if (isEmpty(vars.nextRecord))
	vars.usedCursors default []
else
	(vars.usedCursors default []) + [(vars.nextRecord as String)]]]></ee:set-variable>
				<ee:set-variable variableName="nextRecord"><![CDATA[%dw 2.0
output application/java
---
do {
	var responseXml = write(payload, "application/xml", {writeDeclaration: false})
	var nextMatches = responseXml scan /<TBL\b[^>]*\bnext\s*=\s*["']([^"']+)["']/
	var serverNext = nextMatches[0][1] default null
	---
	if (isEmpty(serverNext))
		null
	else
		serverNext as String
}]]></ee:set-variable>
				<ee:set-variable variableName="serverNext"><![CDATA[%dw 2.0
output application/java
var responseXml = write(payload, "application/xml", {writeDeclaration: false})
var nextMatches = responseXml scan /<TBL\b[^>]*\bnext\s*=\s*["']([^"']+)["']/
---
nextMatches[0][1] default null]]></ee:set-variable>
				<ee:set-variable variableName="pagesFetched"><![CDATA[%dw 2.0
output application/java
---
(vars.pagesFetched default 0) + 1]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Log Pagination State" message="#['Pagina ' ++ (vars.pagesFetched default 0) ++ ' recebida. next do servidor=' ++ (vars.serverNext default 'nao informado') ++ ', cursor |# seguinte=' ++ (vars.nextRecord default 'nao aplicavel')]" />
		<choice doc:name="Has Next Page?">
			<when expression="#[!isEmpty(vars.nextRecord) and !((vars.usedCursors default []) contains (vars.nextRecord as String)) and ((vars.pagesFetched default 0) &lt;= (vars.maxAdditionalPages default 0))]">
				<logger level="INFO" doc:name="Log Next Page" message="#['A obter pagina ' ++ ((vars.pagesFetched default 0) + 1) ++ ' com cursor |#' ++ (vars.nextRecord default '')]" />
				<flow-ref doc:name="Fetch Next Page" name="informacoes-tabelas-fetch-page-subflow" />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="Fim Paginacao" message="#[if (!isEmpty(vars.nextRecord) and ((vars.usedCursors default []) contains (vars.nextRecord as String))) 'Paginacao interrompida: cursor repetido ' ++ (vars.nextRecord as String) else 'Fim da paginacao.']" />
			</otherwise>
		</choice>
	</sub-flow>

